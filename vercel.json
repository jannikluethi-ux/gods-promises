{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm ci && python3 scripts/check_kjv_exposure.py --git && python3 scripts/import_kjv.py --fetch && python3 scripts/build_site.py --target production && python3 scripts/check_kjv_exposure.py --root dist --public",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/feedback.js": {
      "maxDuration": 10,
      "includeFiles": "{promises.json,data/explanations.json,js/ui-shared.js}"
    },
    "api/account.js": {
      "maxDuration": 10
    },
    "api/daily-email.js": {
      "maxDuration": 60,
      "includeFiles": "{promises.json,data/explanations.json,js/daily-verse.js,assets/fonts/*.ttf}"
    },
    "api/og.js": {
      "maxDuration": 15,
      "includeFiles": "{promises.json,data/explanations.json,assets/fonts/*.ttf}"
    },
    "api/unsubscribe.js": {
      "maxDuration": 10
    },
    "api/kjv.js": {
      "maxDuration": 10,
      "includeFiles": "api/_lib/kjv-spans.generated.json"
    }
  },
  "crons": [
    {
      "path": "/api/daily-email",
      "schedule": "0 5 * * *"
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
