{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm ci && python3 scripts/build_site.py --target production",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/feedback.js": {
      "maxDuration": 10,
      "includeFiles": "{promises.json,data/explanations.json,js/ui-shared.js}"
    },
    "api/account.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
